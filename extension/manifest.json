{
  "manifest_version": 3,
  "name": "call-copilot — field autofill",
  "version": "0.1.0",
  "description": "Fills the scheduling form live from the call copilot's extracted fields.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["http://localhost:3000/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["http://localhost:3000/demo-scheduler*", "https://*/demo-scheduler*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
