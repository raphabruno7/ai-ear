# ─────────────────────────────────────────────────────────────
# call-copilot — copy to .env and fill in. Never commit .env.
# ─────────────────────────────────────────────────────────────

# ── AWS (Bedrock extraction + Transcribe streaming STT + SES briefing) ──
# IAM user with policy in listener/AWS.md. Region must have Bedrock + the
# Anthropic Haiku model enabled (us-east-1 is the safe default).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
SES_FROM_EMAIL=briefing@example.com
SES_TO_EMAIL=

# ── LiveKit (NEW project — do not reuse voice-demo keys; isolation matters) ──
LIVEKIT_URL=wss://xxxx.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Gemini (extraction backend when EXTRACT_BACKEND=gemini; also the A/B model) ──
# Two ways to reach Gemini:
#  a) AI Studio key below (free tier = 20 req/day/model)
#  b) Vertex AI — set GCP_PROJECT and run `gcloud auth application-default login`.
#     Billed to the GCP project, no daily cap. Takes precedence over the key.
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-3.6-flash
GCP_PROJECT=
GCP_LOCATION=global

# ── Supabase (NEW project) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Langfuse Cloud (free tier) ──
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── web dashboard + webhooks ──
ADMIN_SECRET=change-me
FIELDS_WEBHOOK_SECRET=change-me
CRON_SECRET=change-me
# listener → web: where to POST extracted-field updates
WEB_BASE_URL=http://localhost:3000
